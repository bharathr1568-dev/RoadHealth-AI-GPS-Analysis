# Environment Configuration Template
# Copy this file to .env and fill in your values if needed

# Groq Vision AI API Key (optional - multimodal quality validation)
GROQ_API_KEY=your_groq_api_key_here

# Officer Authentication Credentials
OFFICER_EMAIL=your_officer_email_or_id
OFFICER_PASSWORD=your_officer_password_here
OFFICER_NAME=your_officer_name_here

# Cloudinary Storage URL (required for persistent cloud image storage in production)
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
